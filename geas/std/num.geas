module Num

// 自動生成（python -m geas.stdgen）。手で編集しない。Rust の標準ライブラリ（core）の整数型のメソッドのうち、
// 宣言から panic も繰り返しもしないと言えるものだけ。範囲は Rust の型から決める。

ltype I8 = int -128..127
ltype I16 = int -32768..32767
ltype I32 = int -2147483648..2147483647
ltype I64 = int -9223372036854775808..9223372036854775807
ltype U8 = int 0..255
ltype U16 = int 0..65535
ltype U32 = int 0..4294967295

