// お店の例：受注と決済要求（試作の最小範囲）
// 名前は半角英数。仕様書に出す日本語の名前は /// で付ける（コンパイラは読まない）。

/// 在庫数
ltype StockCount = int 0..1000000
/// 非負金額
ltype NonNegMoney = money(JPY) 0..10000000
/// 合計金額
ltype OrderTotal = money(JPY) 0..1000000000000
/// 数量
ltype Quantity = int 1..99
/// 商品数量
ltype ProductQuantity = Product → Quantity max 100
/// 税率値
ltype TaxRateValue = ratio 0..1
/// ID集合
ltype IdSet = set of id

/// 商品
entity Product {
  /// 商品ID
  product_id: id unique
  /// 在庫
  stock: StockCount required
  /// 単価
  unit_price: NonNegMoney required
}

/// 顧客
entity Customer {
  /// 顧客ID
  customer_id: id unique
}

/// 注文
entity Order {
  /// 注文ID
  order_id: id unique
  /// 顧客
  customer: ref Customer required
  /// 明細
  items: ProductQuantity required
  /// 合計
  total: OrderTotal required
  /// 状態
  status: OrderStatus
}

/// 注文状態
state OrderStatus {
  /// 受付
  initial Received
  /// 決済要求済
  middle PaymentRequested
  final /// 完了
    Completed, /// キャンセル
    Canceled
  reject Completed → Canceled reason "完了後は返品で扱う"
}

/// 受注結果
result PlaceOrderResult {
  Received(order_id: id)
  /// 在庫不足
  OutOfStock(/// 不足
    short: IdSet)
  /// 商品なし
  NoSuchProduct(/// 未登録
    unregistered: IdSet)
  /// 顧客なし
  NoSuchCustomer
}

/// 決済要求結果
result RequestPaymentResult {
  /// 要求済
  Requested
  /// 注文なし
  NoSuchOrder
  /// 状態違い
  WrongStatus
  /// 合計ゼロ
  ZeroTotal
}

/// 待ち解除結果
result ReleaseResult {
  /// 反映済
  Applied
  NoSuchOrder
  WrongStatus
}

/// 決済
effect Payment. /// 請求
  charge(order_id: id, /// 金額
    amount: money(JPY))

/// 受注
deed place_order {
  input customer_id: id required, items: ProductQuantity required
  /// 税率
  slot tax_rate: TaxRateValue
  reads Product.stock, Product.unit_price, Customer
  writes Product.stock, Order
  transition Order: (new) → Received
  result PlaceOrderResult
  effects none

  let customer = Customer[customer_id] else { return NoSuchCustomer }
  let unregistered = { k | (k, v) in items, Product[k] is absent }
  if unregistered is nonempty { return NoSuchProduct(unregistered) }
  let short = { k | (k, v) in items, Product[k].stock < v }
  if short is nonempty { return OutOfStock(short) }
  update { Product[k].stock -= v | (k, v) in items }
  /// 小計
  let subtotal = sum { Product[k].unit_price * v | (k, v) in items }
  let total = subtotal + round(subtotal * tax_rate, floor, JPY)
  let order = create Order { customer: customer_id, items: items, total: total, status: Received }
  return Received(order.order_id)
}

/// 決済要求
deed request_payment {
  input order_id: id required
  reads Order.total, Order.status
  writes Order.status
  transition Order: Received → PaymentRequested
  result RequestPaymentResult
  effects Payment.charge

  let order = Order[order_id] else { return NoSuchOrder }
  if order.status != Received { return WrongStatus }
  if order.total <= 0 { return ZeroTotal }
  order.status = PaymentRequested
  request Payment.charge(order_id, order.total, idempotency_key = order_id)
  return Requested
}

// 決済待ちを解く2つの処理。どちらも決済要求済の注文だけを動かす（先に起きた要因が勝つ）
/// 決済結果の反映
deed apply_payment_result {
  input order_id: id required
  reads Order.status
  writes Order.status
  transition Order: PaymentRequested → Completed
  result ReleaseResult
  effects none

  let order = Order[order_id] else { return NoSuchOrder }
  if order.status != PaymentRequested { return WrongStatus }
  order.status = Completed
  return Applied
}

/// 決済の期限切れ
deed expire_payment {
  input order_id: id required
  reads Order.status
  writes Order.status
  transition Order: PaymentRequested → Canceled
  result ReleaseResult
  effects none

  let order = Order[order_id] else { return NoSuchOrder }
  if order.status != PaymentRequested { return WrongStatus }
  order.status = Canceled
  return Applied
}

// 読むだけの一覧。select で列を宣言する（customer.customer_id は参照の先、sum(items) は点数の合計）
/// 注文一覧
query order_list {
  from Order
  where status != Canceled
  select order_id, customer.customer_id as customer, sum(items) as /// 点数
    item_count
  reads Order.status, Order.order_id, Order.customer, Customer.customer_id, Order.items
}

// 結果の種類ごとの行き先。reply＝そこでネクサスを終え、結果を呼び出し元へ返す
/// 注文受付
nexus OrderIntake {
  place_order: Received → request_payment, OutOfStock → reply, NoSuchProduct → reply, NoSuchCustomer → reply
  request_payment: Requested → wait PaymentPending, NoSuchOrder → reply, WrongStatus → reply, ZeroTotal → reply
}

// 決済待ちの注文は、決済結果の応答か、30分の期限のどちらか先に起きた方で解かれる
/// 決済待ち
trigger PaymentPending(order_id: id) {
  /// 決済成功
  reply PaymentSucceeded → apply_payment_result
  deadline now + 30 min → expire_payment
}

/// 決済待ち解除
nexus PaymentRelease {
  apply_payment_result: Applied → reply, NoSuchOrder → reply, WrongStatus → reply
  expire_payment: Applied → reply, NoSuchOrder → reply, WrongStatus → reply
}

invariant Product: stock >= 0
invariant Order: status == PaymentRequested implies total > 0
