{
  "manifest_version": 3,
  "name": "お店の価格を見る（Amazon）",
  "version": "0.1.0",
  "description": "Amazon の商品ページで、その商品が「海外にも売るお店」でいくらかを表示します。",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://localhost:8787/*",
    "http://127.0.0.1:8787/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.amazon.co.jp/*",
        "*://www.amazon.com/*"
      ],
      "js": [
        "converter.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "お店の価格を見る",
    "default_popup": "popup.html"
  }
}